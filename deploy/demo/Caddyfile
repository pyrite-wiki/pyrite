{
	order replace after encode
}

demo.pyrite.wiki {
	reverse_proxy demo-pyrite-1:8088
}

www.capturecascade.org {
	redir https://capturecascade.org{uri} permanent
}

capturecascade.org {
	# Inject Plausible analytics into HTML responses.
	# The app's pages send a Content-Security-Policy that blocks injected scripts
	# unless the Pyrite instance behind this block allows them. Set on it:
	#   PYRITE_SITE_CSP_EXTRA="script-src https://plausible.io 'sha256-Ebt84R/xi8miDnxS/0/bkTjVgDRKQpWS1eI09TLbNkg='; connect-src https://plausible.io"
	# The hash is of the inline <script> below; recompute it if that changes.
	replace {
		stream
		"</head>" `<script async src="https://plausible.io/js/pa-nNROWp3fTa6NVDj4WUHkn.js"></script><script>window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};plausible.init()</script></head>`
	}

	# Everything to cascade Pyrite instance
	reverse_proxy deploy-pyrite-1:8088
}
