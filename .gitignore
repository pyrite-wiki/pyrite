# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.pytest_cache/
*.egg-info/
.build/
.dist/
dist/
build/

# Envs
.env
.env.*
.venv/
venv/

# Node.js (web frontend)
node_modules/
.svelte-kit/
web/build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code personal settings (.claude/settings.json is shared: the cloud
# SessionStart hook and the plugins the agents need)
.claude/settings.local.json

# Test artifacts
web/test-results/
web/playwright-report/
# The seeded world the e2e suite builds (web/e2e/global-setup.ts); rebuilt each
# run. Suffixed per worktree with its derived backend port (web/e2e/ports.ts,
# Package A.1, #118) so two worktrees never share a data directory. The bare
# (unsuffixed) lines stay alongside the globs: every worktree that ran the
# suite before this branch has an unsuffixed web/.e2e-data/ on disk already,
# and dropping the bare line would turn it into untracked noise in `git
# status` rather than something the suite ever reads or writes again.
web/.e2e-data/
web/.e2e-data-*/
# The auth-enabled world (web/e2e/auth-setup.ts, Package C); likewise rebuilt
# each run, likewise suffixed per worktree, likewise keeping its pre-existing
# bare line.
web/.e2e-auth-data/
web/.e2e-auth-data-*/

# Playwright MCP (browser automation logs/screenshots)
.playwright-mcp/

# Streamlit
.streamlit/

# OS
.DS_Store
Thumbs.db

# SQLite databases and backups
*.db
*.db-shm
*.db-wal
pyrite-backup-*.db

# Screenshots and images dumped in repo root (from browser reviews, testing)
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.bmp

# Lock files (uv, pip-tools)
uv.lock
*.pip-lock

# Benchmark output
benchmarks/results.json

# Data directory
data/

# Site cache (generated by pyrite)
site-cache/

# Private deployment automation (not shipped to users)
pyrite_deployments/

# Claude Code harness lock files (local runtime state)
.claude/scheduled_tasks.lock

# pytest-cov output
.coverage

# Repo-local pyrite config (a worktree's own KB registry and index; see ADR-0032)
.pyrite/

# A theme spec belongs in the draft PR body, never in the tree (#106)
.claude/THEME.md

# The maintainer's desk: a per-repo, local Pyrite KB (conductor queue, tick logs, retros).
# See docs/conductor-desk.md. Never committed.
desk/

# ADR-0037 theme-0 characterization goldens' regeneration lock sidecars
# (golden_io.py's fcntl.flock target) -- runtime state, not source.
tests/characterization/goldens/*.lock

# Conductor tick logs (default PYRITE_CONDUCTOR_LOG_DIR; local to the machine running the loop)
.pyrite-conductor/
