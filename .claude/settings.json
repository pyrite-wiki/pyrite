{
  "enabledPlugins": {
    "playwright@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cloud-session-start.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
